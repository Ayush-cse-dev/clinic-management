# Copy this file to .env and adjust as needed.
# Defaults below work out of the box with zero setup (SQLite file DB).

# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./clinic.db

# Postgres example (uncomment and edit, then uncomment psycopg2-binary in requirements.txt):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/clinic_db

SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
